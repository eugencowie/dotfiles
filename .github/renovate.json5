{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "schedule:weekly"],
  labels: ["chore"],

  constraints: {
    // mise 2026.10.19 `mise lock` keeps platform URLs from the previously
    // locked version after Renovate bumps `version`, leaving mise.lock broken.
    mise: "2026.10.18",
  },

  nix: {
    enabled: true,
    // Renovate only regenerates its lock file maintenance branch on rebase, so
    // the PR goes stale if not merged immediately. We use update-flake-lock in
    // workflows/renovate.yml which force-pushes the same branch every time, so
    // its PR always has the latest inputs.
    lockFileMaintenance: {
      enabled: false,
    },
  },

  customManagers: [
    {
      description: "Update Renovate version",
      customType: "regex",
      managerFilePatterns: [".github/workflows/renovate.yml"],
      matchStrings: [
        "renovate-version:\\s*(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>\\S+))?",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/renovatebot/renovate",
      autoReplaceStringTemplate: "renovate-version: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
    },
    {
      description: "Update template version",
      customType: "regex",
      managerFilePatterns: [".cruft.json"],
      matchStrings: ['"checkout"\\s*:\\s*(?:"(?<currentValue>[^"]+)"|null)'],
      datasourceTemplate: "github-tags",
      depNameTemplate: "eugencowie/templates",
      currentValueTemplate: "{{#if currentValue}}{{{currentValue}}}{{else}}v0.0.0{{/if}}",
      autoReplaceStringTemplate: '"checkout": "{{{newValue}}}"',
    },
  ],

  packageRules: [
    {
      description: "Apply template update using cruft",
      matchDepNames: ["eugencowie/templates"],
      postUpgradeTasks: {
        executionMode: "branch",
        installTools: { mise: {} },
        commands: [
          "git restore -s HEAD .cruft.json",
          "mise install --locked",
          "mise run --skip-tools template:update --skip-apply-ask --checkout {{{newValue}}}",
          "mise lock",
        ],
      },
    },
  ],
}
