{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices'],
  labels: ['chore'],

  lockFileMaintenance: {
    schedule: ['at any time'],
  },

  nix: {
    enabled: true,
  },

  customManagers: [
    {
      description: 'Track template updates',
      customType: 'regex',
      managerFilePatterns: ['/^\\.cruft\\.json$/'],
      matchStrings: ['"checkout"\\s*:\\s*"(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'eugencowie/templates',
    },
    {
      description: 'Bootstrap template release tracking',
      customType: 'regex',
      managerFilePatterns: ['/^\\.cruft\\.json$/'],
      matchStrings: ['"checkout"\\s*:\\s*null'],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'eugencowie/templates',
      currentValueTemplate: 'v0.0.0',
      autoReplaceStringTemplate: '"checkout": "{{{newValue}}}"',
    },
    {
      description: 'Track the pinned Renovate version',
      customType: 'regex',
      managerFilePatterns: ['/^\\.github\/workflows\/renovate\\.yml$/'],
      matchStrings: [
        'renovate-version:\\s*(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>\\S+))?',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      autoReplaceStringTemplate:
        'renovate-version: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}',
    },
    {
      description: 'Track T3 Code nightly releases',
      customType: 'regex',
      managerFilePatterns: ['/^packages\\/t3code-nightly\\.nix$/'],
      matchStrings: ['version\\s*=\\s*"(?<currentValue>[^"]+)";'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'pingdotgg/t3code',
      extractVersionTemplate:
        '^v(?<version>\\d+\\.\\d+\\.\\d+-nightly\\.\\d+\\.\\d+)$',
      versioningTemplate: 'semver',
    },
  ],

  packageRules: [
    {
      description: 'Template updates get their own PR and apply via cruft',
      matchManagers: ['custom.regex'],
      matchDepNames: ['eugencowie/templates'],
      groupName: 'eugencowie/templates',
      postUpgradeTasks: {
        commands: [
          'git restore --source=HEAD -- .cruft.json',
          'mise run template:update -- -y --checkout {{{newValue}}}',
        ],
        executionMode: 'branch',
        fileFilters: ['**/*'],
        installTools: {
          mise: {},
          python: {},
        },
      },
    },
    {
      description: 'Update T3 Code nightly and its fixed-output hashes',
      matchManagers: ['custom.regex'],
      matchDepNames: ['pingdotgg/t3code'],
      ignoreUnstable: false,
      postUpgradeTasks: {
        commands: ['mise run update:t3code -- {{{newValue}}}'],
        executionMode: 'update',
        fileFilters: ['packages/t3code-nightly.nix'],
        installTools: {
          mise: {},
          python: {},
        },
      },
    },
  ],
}
